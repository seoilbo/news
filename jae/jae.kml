			</PolyStyle>
			<BalloonStyle>
				<text><![CDATA[<!-- [통합 표 1] 시공사 브랜드 및 조감도(시공사) 통합 표 -->
<table border="0" style="width:100%; border-collapse: collapse; font-size: 14px; line-height: 1.4; background-color: #e1dbcd; border-radius: 4px; margin-bottom: 12px; overflow: hidden;">
  <!-- 상단: 브랜드 및 단지명 정보 -->
  <tr>
    <!-- 왼쪽: 시공사 + 단지명 -->
    <td style="padding: 14px 12px; width: 65%; vertical-align: middle;">
      <div style="font-size: 11px; color: rgba(0, 0, 0, 0.7); font-weight: bold; margin-bottom: 4px;">IPARK현대산업개발</div>
      <div style="font-size: 19px; color: #000000; font-weight: bold; letter-spacing: -0.5px;">아이파크 그레이튼</div>
    </td>
    <!-- 오른쪽: 아이파크 브랜드 로고 링크 매칭 -->
    <td style="padding: 14px 12px; width: 35%; text-align: center; vertical-align: middle;">
