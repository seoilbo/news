	<gx:CascadingStyle kml:id="__managed_style_08CC78327742C0B407EF_normal">
		<ex:extension>base64;EgIYAQ</ex:extension>
		<Style>
			<IconStyle>
				<Icon>
					<href>https://earth.google.com/earth/document/icon?color=1976d2&amp;id=2000&amp;scale=4</href>
				</Icon>
				<hotSpot x="64" y="128" xunits="pixels" yunits="insetPixels"/>
			</IconStyle>
			<LabelStyle>
			</LabelStyle>
			<LineStyle>
				<color>ff3c8e38</color>
				<width>1.778</width>
			</LineStyle>
			<PolyStyle>
				<color>403c8e38</color>
			</PolyStyle>
			<BalloonStyle>
				<text><![CDATA[<!-- [통합 표 1] 시공사 브랜드 및 조감도(시공사) 통합 표 -->
<table border="0" style="width:100%; border-collapse: collapse; font-size: 14px; line-height: 1.4; background-color: #d3d3cd; border-radius: 4px; margin-bottom: 12px; overflow: hidden;">
  <!-- 상단: 브랜드 및 단지명 정보 -->
  <tr>
    <!-- 왼쪽: 시공사 + 단지명 -->
    <td style="padding: 14px 12px; width: 65%; vertical-align: middle;">
      <div style="font-size: 11px; color: rgba(0, 0, 0, 0.7); font-weight: bold; margin-bottom: 4px;">제일건설</div>
      <div style="font-size: 19px; color: #000000; font-weight: bold; letter-spacing: -0.5px;">미정</div>
    </td>
    <!-- 오른쪽: 아이파크 브랜드 로고 링크 매칭 -->
    <td style="padding: 14px 12px; width: 35%; text-align: center; vertical-align: middle;">
      <img src="https://i.namu.wiki/i/Qzx-UBXyBT1Y5__212Rn30N40ZNZBC0-QSLgh9GAgO81yBE_0uUQ7O8YfXQtGKcLmarlzrdz1NSuA5xaiJLGFtJC7-PqmKj_Fic0xc-N5rPebnBznI2AmmqGM4O5bKiPUcFOM4rZecSt44KDp88oEA.svg" alt="브랜드 로고" style="max-width: 100%; max-height: 42px; object-fit: contain;">
    </td>
  </tr>
</table>

<!-- [통합 표 2] 구역 기본 정보 및 조감도(설계사) 통합 표 -->
<table border="1" style="width:100%; border-collapse: collapse; font-size: 14px; line-height: 1.6; border: 1px solid #e1dbcd;">
  <!-- 표 내부 최상단: 조감도(설계사) 16:9 비율 유지 -->
  <tr>
    <td colspan="2" style="padding: 0; text-align: center; border: 1px solid #e1dbcd; font-size: 0;">
      <img src="https://wimg.sedaily.com/news/cms/2026/01/29/news-p.v1.20260129.c329eec63a4748598cf0ebffdc93dcb4_P1.jpg" alt="조감도(설계사)" style="width: 100%; aspect-ratio: 16/9; object-fit: cover; display: block;">
    </td>
  </tr>
  <tr>
    <td style="padding: 10px; width: 30%; background-color: #fcfcfc; font-weight: bold; text-align: center; border: 1px solid #eee;">사업 명칭</td>
    <td style="padding: 10px; border: 1px solid #eee;">동부화물터미널 복합개발 사업</td>
  </tr>
  <tr>
    <td style="padding: 10px; background-color: #fcfcfc; font-weight: bold; text-align: center; border: 1px solid #eee;">위치</td>
    <td style="padding: 10px; border: 1px solid #eee;">서울특별시 동대문구 장안동 283-1 일대</td>
  </tr>
  <tr>
    <td style="padding: 10px; background-color: #fcfcfc; font-weight: bold; text-align: center; border: 1px solid #eee;">건립 규모</td>
    <td style="padding: 10px; border: 1px solid #eee;">지상 최고 49층 / 총 	
620세대(예정)</td>
  </tr>
  <tr>
    <td style="padding: 10px; background-color: #fcfcfc; font-weight: bold; text-align: center; border: 1px solid #eee;">현재 단계</td>
    <td style="padding: 10px; color: #d93025; font-weight: bold; border: 1px solid #eee;"> </td>
  </tr>
</table>
]]></text>
			</BalloonStyle>
		</Style>
	</gx:CascadingStyle>
